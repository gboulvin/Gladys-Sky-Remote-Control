{
  "manifest_version": 1,
  "type": "device",
  "name": "Sky Remote Control",
  "description": {
    "en": "Control your Sky Q and Sky+ HD boxes from Gladys over your local network.",
    "fr": "Pilotez vos décodeurs Sky Q et Sky+ HD depuis Gladys, en réseau local.",
    "de": "Steuern Sie Ihre Sky Q und Sky+ HD Receiver lokal über Gladys.",
    "es": "Controle sus decodificadores Sky Q y Sky+ HD desde Gladys en su red local."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/gboulvin/gladys-sky-remote-control:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/gboulvin/Gladys-Sky-Remote-Control/main/cover.png",
  "categories": ["multimedia"],
  "transports": ["local"],
  "countries": ["GB", "IE", "IT", "DE", "AT"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "Gladys drives your Sky boxes directly over your local network, like the Sky remote app: no account, no cloud. Give each box a fixed IP address in your router, then list them below.",
        "fr": "Gladys pilote vos décodeurs Sky directement sur votre réseau local, comme l'application télécommande Sky : pas de compte, pas de cloud. Donnez une adresse IP fixe à chaque décodeur dans votre box internet, puis listez-les ci-dessous.",
        "de": "Gladys steuert Ihre Sky-Receiver direkt über Ihr lokales Netzwerk, wie die Sky-Fernbedienungs-App: kein Konto, keine Cloud. Geben Sie jedem Receiver in Ihrem Router eine feste IP-Adresse und tragen Sie sie unten ein.",
        "es": "Gladys controla sus decodificadores Sky directamente en su red local, como la aplicación de mando Sky: sin cuenta ni nube. Asigne una dirección IP fija a cada decodificador en su router y añádalos abajo."
      },
      "links": [
        {
          "url": "https://github.com/gboulvin/Gladys-Sky-Remote-Control#readme",
          "label": {
            "en": "Documentation",
            "fr": "Documentation",
            "de": "Dokumentation",
            "es": "Documentación"
          }
        }
      ]
    },
    {
      "key": "boxes",
      "type": "string",
      "label": {
        "en": "Sky boxes",
        "fr": "Décodeurs Sky",
        "de": "Sky-Receiver",
        "es": "Decodificadores Sky"
      },
      "description": {
        "en": "IP address of each box, separated by commas. Optionally name it: \"Living room=192.168.1.20, Bedroom=192.168.1.21\".",
        "fr": "Adresse IP de chaque décodeur, séparées par des virgules. Vous pouvez les nommer : « Salon=192.168.1.20, Chambre=192.168.1.21 ».",
        "de": "IP-Adresse jedes Receivers, durch Kommas getrennt. Optional mit Namen: „Wohnzimmer=192.168.1.20, Schlafzimmer=192.168.1.21“.",
        "es": "Dirección IP de cada decodificador, separadas por comas. Puede nombrarlos: «Salón=192.168.1.20, Dormitorio=192.168.1.21»."
      },
      "placeholder": {
        "en": "e.g. Living room=192.168.1.20",
        "fr": "ex. Salon=192.168.1.20",
        "de": "z. B. Wohnzimmer=192.168.1.20",
        "es": "p. ej. Salón=192.168.1.20"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "model",
      "type": "select",
      "label": {
        "en": "Box model",
        "fr": "Modèle de décodeur",
        "de": "Receiver-Modell",
        "es": "Modelo de decodificador"
      },
      "description": {
        "en": "Automatic tries the Sky Q port (49160), then the Sky+ HD one (5900).",
        "fr": "Automatique essaie le port Sky Q (49160), puis celui du Sky+ HD (5900).",
        "de": "Automatisch versucht den Sky-Q-Port (49160), dann den Sky+-HD-Port (5900).",
        "es": "Automático prueba el puerto Sky Q (49160) y luego el de Sky+ HD (5900)."
      },
      "required": false,
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": {
            "en": "Automatic",
            "fr": "Automatique",
            "de": "Automatisch",
            "es": "Automático"
          }
        },
        {
          "value": "sky_q",
          "label": {
            "en": "Sky Q",
            "fr": "Sky Q",
            "de": "Sky Q",
            "es": "Sky Q"
          }
        },
        {
          "value": "sky_plus",
          "label": {
            "en": "Sky+ HD (or Sky Q on old firmware)",
            "fr": "Sky+ HD (ou Sky Q avec un ancien logiciel)",
            "de": "Sky+ HD (oder Sky Q mit alter Firmware)",
            "es": "Sky+ HD (o Sky Q con firmware antiguo)"
          }
        }
      ]
    },
    {
      "key": "status_polling",
      "type": "boolean",
      "label": {
        "en": "Read the power state (Sky Q)",
        "fr": "Lire l'état d'alimentation (Sky Q)",
        "de": "Betriebszustand lesen (Sky Q)",
        "es": "Leer el estado de encendido (Sky Q)"
      },
      "description": {
        "en": "Every 30 seconds, asks each Sky Q whether it is on or in standby (local API, port 9006). Needed by the \"Power changed\" scene trigger.",
        "fr": "Toutes les 30 secondes, demande à chaque Sky Q s’il est allumé ou en veille (API locale, port 9006). Nécessaire au déclencheur de scène « Alimentation modifiée ».",
        "de": "Fragt alle 30 Sekunden jeden Sky Q, ob er eingeschaltet oder im Standby ist (lokale API, Port 9006). Für den Szenen-Auslöser „Betriebszustand geändert“ nötig.",
        "es": "Cada 30 segundos, pregunta a cada Sky Q si está encendido o en espera (API local, puerto 9006). Necesario para el disparador de escena «Encendido cambiado»."
      },
      "required": false,
      "default": true
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Checks that every configured box answers, without pressing any key.",
        "fr": "Vérifie que chaque décodeur configuré répond, sans appuyer sur aucune touche.",
        "de": "Prüft, ob jeder konfigurierte Receiver antwortet, ohne eine Taste zu drücken.",
        "es": "Comprueba que cada decodificador configurado responde, sin pulsar ninguna tecla."
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "power_changed",
      "label": {
        "en": "Sky box power changed",
        "fr": "Alimentation du décodeur Sky modifiée",
        "de": "Betriebszustand des Sky-Receivers geändert",
        "es": "Encendido del decodificador Sky cambiado"
      },
      "description": {
        "en": "A Sky Q box was turned on or went to standby (needs \"Read the power state\").",
        "fr": "Un décodeur Sky Q s'est allumé ou mis en veille (nécessite « Lire l'état d'alimentation »).",
        "de": "Ein Sky-Q-Receiver wurde eingeschaltet oder ging in Standby („Betriebszustand lesen“ nötig).",
        "es": "Un decodificador Sky Q se encendió o pasó a espera (requiere «Leer el estado de encendido»)."
      },
